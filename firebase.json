{
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix functions run build"
    ]
  },
  "hosting": [
    {
      "target": "app",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/sdk.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300"
            },
            {
              "key": "Content-Type",
              "value": "application/javascript; charset=utf-8"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api{,/**}",
          "function": "api"
        },
        {
          "source": "/mcp{,/**}",
          "function": "api"
        },
        {
          "source": "/ops{,/**}",
          "destination": "/ops/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "help",
      "public": "help",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
